<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>IslandHub.Server</RootNamespace>
    <AssemblyName>IslandHub.Server</AssemblyName>
    <Version>1.0.0</Version>
    <Product>IslandHub 系统 · 服务端</Product>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.*" />
    <!-- 支持以 Windows 服务方式运行（可由 sh/install-windows.ps1 一键注册）。 -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.*" />
    <!-- #95 机器可读的接口规范（OpenAPI 3.1）：从运行时端点表生成，见 Endpoints/OpenApiEndpoints.cs。
         用第一方包而不是自己拼 JSON —— 它能把我们那一堆 DTO 生成出字段级 schema。 -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- 让 dotnet build 的输出目录也包含前端静态资源，便于直接运行输出目录中的程序。 -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IslandHub.Protocol\IslandHub.Protocol.csproj" />
  </ItemGroup>

</Project>
