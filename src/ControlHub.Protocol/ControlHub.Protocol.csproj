    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ControlHub.Protocol</RootNamespace>
    <AssemblyName>ControlHub.Protocol</AssemblyName>
