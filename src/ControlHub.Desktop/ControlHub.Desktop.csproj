<!--
  ⚠️ 已冻结（实验性）：这是早期尝试的「原生 Avalonia 管理界面」，与 A 端 Web 管理界面功能重复。
  自 1.3.x 起不再同步新功能（缺定时提醒 / Webhook / 两步验证 / 远程诊断等），也不随 Release 分发。
  面向用户的桌面入口请用 src/ControlHub.Shell（薄外壳，复用 Web UI），本项目的价值仅剩「原生 Avalonia 客户端写法参考」。
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ControlHub.Desktop</RootNamespace>
    <AssemblyName>ControlHub.Desktop</AssemblyName>
    <Version>1.0.0</Version>
    <Product>ClassislandControlHub 集控管理端</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControlHub.Protocol\ControlHub.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\**" />
  </ItemGroup>

</Project>
