<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ControlHub.Server</RootNamespace>
    <AssemblyName>ControlHub.Server</AssemblyName>
    <Version>1.0.0</Version>
    <Product>ClassIsland 集控系统 · 服务端</Product>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- 让 dotnet build 的输出目录也包含前端静态资源，便于直接运行输出目录中的程序。 -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControlHub.Protocol\ControlHub.Protocol.csproj" />
  </ItemGroup>

</Project>
