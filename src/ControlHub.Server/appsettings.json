{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ControlHub": {
    "ServerName": "ClassIsland 集控服务器",
    "HttpPort": 29800,
    "BindAddress": "0.0.0.0",
    "EnableHttps": false,
    "HttpsPort": 29801,
    "PublicBaseUrl": null,
    "DataDirectory": "data",
    "RequireEnrollCode": true,
    "EnableDiscovery": true,
    "DiscoveryPort": 29810,
    "OnlineTimeoutSeconds": 120,
    "SessionLifetimeHours": 12,
    "ClientLogRetentionDays": 30,
    "AuditLogRetentionDays": 180,
    "DefaultAdminUser": "admin",
    "DefaultAdminPassword": "admin123",
    "CorsAllowedOrigins": []
  }
}
