<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- 测试项目也当生产代码管：警告即错误，避免「测试里有一堆没人看的告警」。 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit 不在隐式 using 里：官方模板就是靠这一行让测试文件不必逐个 using Xunit。 -->
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ControlHub.Protocol/ControlHub.Protocol.csproj" />
    <ProjectReference Include="../../src/ControlHub.Server/ControlHub.Server.csproj" />
  </ItemGroup>

</Project>
